# ============================================================
# AI Financial Budget Advisor - Environment Configuration
# ============================================================

# Database (MySQL)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=budget_advisor

# Server
PORT=5000
NODE_ENV=development

# JWT Security (use a long random string in production)
JWT_SECRET=your-super-secret-jwt-key-minimum-32-chars-change-in-prod
JWT_EXPIRES_IN=24h

# ============================================================
# Email Configuration (Gmail SMTP)
# Use App Password: Google Account > Security > App passwords
# ============================================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=aifinancialbudgetadvisor@gmail.com
EMAIL_PASS=your_gmail_app_password_here
EMAIL_FROM_NAME=AI Financial Budget Advisor

# ============================================================
# Twilio (SMS - Optional, OTP via email works without this)
# ============================================================
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# ============================================================
# AI / Claude API
# Get key from: https://console.anthropic.com
# ============================================================
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-sonnet-4-20250514

# ============================================================
# Stock Market APIs (Free tiers available)
# ============================================================

# Alpha Vantage - Real-time stock data (Free: 25 req/day)
# Get key: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key

# Finnhub - Stock prices + news (Free: 60 req/min)
# Get key: https://finnhub.io/register
FINNHUB_API_KEY=your_finnhub_key

# NewsAPI - Financial news (Free: 100 req/day)
# Get key: https://newsapi.org/register
NEWS_API_KEY=your_newsapi_key

# ============================================================
# Frontend URL (for CORS & email links)
# ============================================================
FRONTEND_URL=http://localhost:3000
